<?xml version="1.0" encoding="UTF-8" standalone="yes"?>
<assembly xmlns="urn:schemas-microsoft-com:asm.v1" manifestVersion="1.0">
  <assemblyIdentity type="win32" name="LucentTTS.LucentConfig" version="1.0.2.0" processorArchitecture="*" />
  <description>Lucent TTS Configuration utility</description>
  <trustInfo xmlns="urn:schemas-microsoft-com:asm.v3">
    <security>
      <requestedPrivileges>
        <!-- Settings live in HKCU and %LOCALAPPDATA%; the utility never needs to elevate.
             Saying so explicitly also stops Windows' installer-detection heuristic from
             guessing at an executable whose name contains "Config". -->
        <requestedExecutionLevel level="asInvoker" uiAccess="false" />
      </requestedPrivileges>
    </security>
  </trustInfo>
  <dependency>
    <dependentAssembly>
      <assemblyIdentity type="win32" name="Microsoft.Windows.Common-Controls" version="6.0.0.0" processorArchitecture="*" publicKeyToken="6595b64144ccf1df" language="*" />
    </dependentAssembly>
  </dependency>
  <compatibility xmlns="urn:schemas-microsoft-com:compatibility.v1">
    <application>
      <!-- Windows Vista, 7, 8, 8.1, and 10/11.  Without this block Windows treats the
           process as a pre-Vista legacy binary and applies compatibility shims. -->
      <supportedOS Id="{e2011457-1546-43c5-a5fe-008deee3d3f0}" />
      <supportedOS Id="{35138b9a-5d96-4fbd-8e2d-a2440225f93a}" />
      <supportedOS Id="{4a2f28e3-53b9-4441-ba9c-d69d4a4a6e38}" />
      <supportedOS Id="{1f676c76-80e1-4239-95bb-83d0f6d0da78}" />
      <supportedOS Id="{8e0f7a12-bfb3-4fe8-b9a5-48fd50a15a9a}" />
    </application>
  </compatibility>
  <!-- Deliberately no <dpiAware> entry: the dialog lays itself out once in dialog units
       and never handles WM_DPICHANGED, so declaring awareness would leave it mis-sized on
       a high-DPI display.  Staying DPI-unaware keeps Windows' bitmap scaling, which is
       blurry but always the right size for the screen reader and the mouse. -->
</assembly>
