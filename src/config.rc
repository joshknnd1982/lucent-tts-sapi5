#include <windows.h>
#include <commctrl.h>
#include "config_resource.h"

// Every edit control is immediately preceded by its own static label so MSAA (and
// therefore NVDA / JAWS) names it from that label.  Up-down buttons are not tab stops.

IDD_MAIN DIALOGEX 0, 0, 420, 322
STYLE DS_SETFONT | DS_MODALFRAME | DS_CENTER | WS_POPUP | WS_CAPTION | WS_SYSMENU | WS_MINIMIZEBOX
CAPTION "Lucent TTS Configuration"
FONT 9, "MS Shell Dlg", 0, 0, 0x1
BEGIN
    GROUPBOX        "Custom voice", -1, 7, 4, 406, 66
    LTEXT           "&Language:", -1, 14, 18, 60, 8
    COMBOBOX        IDC_LANGUAGE, 76, 16, 130, 120, CBS_DROPDOWNLIST | WS_VSCROLL | WS_TABSTOP
    LTEXT           "&Voice:", -1, 216, 18, 50, 8
    COMBOBOX        IDC_SPEAKER, 268, 16, 138, 120, CBS_DROPDOWNLIST | WS_VSCROLL | WS_TABSTOP
    LTEXT           "Sample &rate:", -1, 14, 38, 60, 8
    COMBOBOX        IDC_SAMPLERATE, 76, 36, 130, 60, CBS_DROPDOWNLIST | WS_TABSTOP
    CONTROL         "&Email preprocessing (reads e-mail headers and quoting)", IDC_EMAIL, "Button", BS_AUTOCHECKBOX | WS_TABSTOP, 216, 38, 190, 10
    LTEXT           "All values below are percentages: 0 is the lowest setting the engine allows, 100 the highest.", -1, 14, 54, 392, 8

    GROUPBOX        "Prosody", -1, 7, 74, 200, 96
    LTEXT           "S&peaking speed (%):", IDC_SPEED_LABEL, 14, 90, 110, 8
    EDITTEXT        IDC_SPEED, 130, 88, 40, 12, ES_NUMBER | ES_AUTOHSCROLL
    CONTROL         "", IDC_SPEED_SPIN, UPDOWN_CLASS, UDS_SETBUDDYINT | UDS_ALIGNRIGHT | UDS_ARROWKEYS | UDS_NOTHOUSANDS, 170, 88, 11, 12
    LTEXT           "&Top pitch (%):", IDC_TOP_LABEL, 14, 108, 110, 8
    EDITTEXT        IDC_TOP, 130, 106, 40, 12, ES_NUMBER | ES_AUTOHSCROLL
    CONTROL         "", IDC_TOP_SPIN, UPDOWN_CLASS, UDS_SETBUDDYINT | UDS_ALIGNRIGHT | UDS_ARROWKEYS | UDS_NOTHOUSANDS, 170, 106, 11, 12
    LTEXT           "Re&ference line pitch (%):", IDC_REF_LABEL, 14, 126, 110, 8
    EDITTEXT        IDC_REF, 130, 124, 40, 12, ES_NUMBER | ES_AUTOHSCROLL
    CONTROL         "", IDC_REF_SPIN, UPDOWN_CLASS, UDS_SETBUDDYINT | UDS_ALIGNRIGHT | UDS_ARROWKEYS | UDS_NOTHOUSANDS, 170, 124, 11, 12
    LTEXT           "&Bottom pitch (%):", IDC_BOTTOM_LABEL, 14, 144, 110, 8
    EDITTEXT        IDC_BOTTOM, 130, 142, 40, 12, ES_NUMBER | ES_AUTOHSCROLL
    CONTROL         "", IDC_BOTTOM_SPIN, UPDOWN_CLASS, UDS_SETBUDDYINT | UDS_ALIGNRIGHT | UDS_ARROWKEYS | UDS_NOTHOUSANDS, 170, 142, 11, 12

    GROUPBOX        "Voice quality", -1, 213, 74, 200, 96
    LTEXT           "Breat&hiness (%):", IDC_BREATH_LABEL, 220, 90, 110, 8
    EDITTEXT        IDC_BREATH, 336, 88, 40, 12, ES_NUMBER | ES_AUTOHSCROLL
    CONTROL         "", IDC_BREATH_SPIN, UPDOWN_CLASS, UDS_SETBUDDYINT | UDS_ALIGNRIGHT | UDS_ARROWKEYS | UDS_NOTHOUSANDS, 376, 88, 11, 12
    LTEXT           "Spectral t&ilt (%):", IDC_TILT_LABEL, 220, 108, 110, 8
    EDITTEXT        IDC_TILT, 336, 106, 40, 12, ES_NUMBER | ES_AUTOHSCROLL
    CONTROL         "", IDC_TILT_SPIN, UPDOWN_CLASS, UDS_SETBUDDYINT | UDS_ALIGNRIGHT | UDS_ARROWKEYS | UDS_NOTHOUSANDS, 376, 106, 11, 12
    LTEXT           "Fro&nt vocal tract (%):", IDC_FRONT_LABEL, 220, 126, 110, 8
    EDITTEXT        IDC_FRONT, 336, 124, 40, 12, ES_NUMBER | ES_AUTOHSCROLL
    CONTROL         "", IDC_FRONT_SPIN, UPDOWN_CLASS, UDS_SETBUDDYINT | UDS_ALIGNRIGHT | UDS_ARROWKEYS | UDS_NOTHOUSANDS, 376, 124, 11, 12
    LTEXT           "Bac&k vocal tract (%):", IDC_BACK_LABEL, 220, 144, 110, 8
    EDITTEXT        IDC_BACK, 336, 142, 40, 12, ES_NUMBER | ES_AUTOHSCROLL
    CONTROL         "", IDC_BACK_SPIN, UPDOWN_CLASS, UDS_SETBUDDYINT | UDS_ALIGNRIGHT | UDS_ARROWKEYS | UDS_NOTHOUSANDS, 376, 142, 11, 12

    GROUPBOX        "Output", -1, 7, 174, 406, 50
    LTEXT           "Volu&me (%):", IDC_VOLUME_LABEL, 14, 190, 110, 8
    EDITTEXT        IDC_VOLUME, 130, 188, 40, 12, ES_NUMBER | ES_AUTOHSCROLL
    CONTROL         "", IDC_VOLUME_SPIN, UPDOWN_CLASS, UDS_SETBUDDYINT | UDS_ALIGNRIGHT | UDS_ARROWKEYS | UDS_NOTHOUSANDS, 170, 188, 11, 12
    CONTROL         "Let SAPI &applications adjust rate, pitch and volume on top of these settings", IDC_SAPIPROSODY, "Button", BS_AUTOCHECKBOX | WS_TABSTOP, 14, 206, 300, 10
    CONTROL         "Write lo&g files", IDC_LOGGING, "Button", BS_AUTOCHECKBOX | WS_TABSTOP, 220, 190, 90, 10
    CONTROL         "Keep engine &diagnostic log", IDC_ENGINELOG, "Button", BS_AUTOCHECKBOX | WS_TABSTOP, 316, 190, 92, 10

    GROUPBOX        "Try it", -1, 7, 228, 406, 62
    LTEXT           "Test te&xt:", -1, 14, 244, 60, 8
    EDITTEXT        IDC_TESTTEXT, 76, 242, 330, 12, ES_AUTOHSCROLL
    PUSHBUTTON      "Te&st", IDC_TEST, 76, 262, 60, 16
    PUSHBUTTON      "S&top", IDC_STOP, 140, 262, 60, 16
    LTEXT           "", IDC_STATUS, 206, 266, 200, 10, SS_NOPREFIX

    PUSHBUTTON      "Restore defa&ults", IDC_DEFAULTS, 7, 298, 90, 16
    PUSHBUTTON      "&Open log folder", IDC_OPENLOGS, 103, 298, 90, 16
    DEFPUSHBUTTON   "&Close", IDCANCEL, 353, 298, 60, 16
END

IDI_APP ICON "config.ico"

1 VERSIONINFO
FILEVERSION 1,0,0,0
PRODUCTVERSION 1,0,0,0
FILEOS 0x4
FILETYPE 0x1
BEGIN
    BLOCK "StringFileInfo"
    BEGIN
        BLOCK "040904b0"
        BEGIN
            VALUE "CompanyName", "Lucent TTS SAPI 5 wrapper"
            VALUE "FileDescription", "Lucent TTS Configuration"
            VALUE "FileVersion", "1.0.0.0"
            VALUE "InternalName", "LucentConfig"
            VALUE "OriginalFilename", "LucentConfig.exe"
            VALUE "ProductName", "Lucent TTS SAPI 5"
            VALUE "ProductVersion", "1.0.0.0"
        END
    END
    BLOCK "VarFileInfo"
    BEGIN
        VALUE "Translation", 0x409, 1200
    END
END
