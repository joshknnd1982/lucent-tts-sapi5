// Version resource for the SAPI 5 engine DLL (built for x86 and x64 alike).
#include <windows.h>
#include "version.h"

1 VERSIONINFO
FILEVERSION LUCENT_VERSION_COMMA
PRODUCTVERSION LUCENT_VERSION_COMMA
FILEFLAGSMASK VS_FFI_FILEFLAGSMASK
FILEFLAGS 0x0L
FILEOS VOS_NT_WINDOWS32
FILETYPE VFT_DLL
FILESUBTYPE VFT2_UNKNOWN
BEGIN
    BLOCK "StringFileInfo"
    BEGIN
        BLOCK "040904b0"
        BEGIN
            VALUE "CompanyName", LUCENT_COMPANY
            VALUE "FileDescription", "Lucent TTS SAPI 5 speech engine"
            VALUE "FileVersion", LUCENT_VERSION_STR
            VALUE "InternalName", "LucentSAPI"
            VALUE "LegalCopyright", LUCENT_COPYRIGHT
            VALUE "OriginalFilename", "LucentSAPI.dll"
            VALUE "ProductName", LUCENT_PRODUCT
            VALUE "ProductVersion", LUCENT_VERSION_STR
            VALUE "Comments", "SAPI 5 text-to-speech engine that drives the Lucent ttsserver.exe synthesiser. " LUCENT_URL
        END
    END
    BLOCK "VarFileInfo"
    BEGIN
        VALUE "Translation", 0x409, 1200
    END
END
